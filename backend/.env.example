# Copy to ".env" in this folder and fill in. Restart uvicorn after changes.

# Required for Gemini calendar extraction (get a key from Google AI Studio / Vertex).
GEMINI_API_KEY=

# Optional: set to false to force regex-only week parsing even if GEMINI_API_KEY is set.
# USE_GEMINI_HOLIDAY_EXTRACTION=true

# Optional model override (default is in app/core/config.py).
# GEMINI_MODEL=gemini-3.1-flash-lite-preview
